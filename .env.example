# Generate locally: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Set true behind public HTTPS. False only for localhost HTTP.
COOKIE_SECURE=true
DATABASE_PATH=/data/unibot.db
# Generate hash locally with werkzeug.security.generate_password_hash. Never commit a real password/hash.
ADMIN_PASSWORD_HASH=
# Optional. Both values required. Without these, curated retrieval works normally.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
